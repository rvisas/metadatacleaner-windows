msgstr "Dosya Türü Desteklenmiyor"

#. translators: error shown on the side panel when selecting
#. a file
msgid "Unable to Check for Metadata"
msgstr "Meta Veriler Denetlenemiyor"

#. translators: error shown on the side panel when selecting
#. a file
msgid "No Known Metadata"
msgstr "Bilinen Üst Veri Yok"

#. translators: error shown on the side panel when
#. selecting a file
msgid "Unable to Remove Metadata"
msgstr "Üst Veriler Kaldırılamıyor"

#. translators: message shown on the side panel when selecting a
#. file that doesn't have known metadata
msgid "The file will be cleaned anyway to be sure."
msgstr "Dosya yine de emin olmak için temizlenecek."

#. translators: message shown on the side panel when no file
#. has been selected
msgid "Select a file to view its metadata"
msgstr "Üst verilerinini görüntülemek için dosya seç"

#. translators: progress bar subtitle while loading files
msgid "Processing file {}/{}"
msgstr "{}/{} dosya işleniyor"

#. translators: progress bar subtitle while cleaning files
msgid "Cleaning file {}/{}"
msgstr "{}/{} dosya temizleniyor"

