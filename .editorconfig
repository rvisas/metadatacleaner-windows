root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{ico,png,jpg,jpeg,woff,woff2}]
insert_final_newline = false
