  <releases its:locNote="Release notes">
    <release version="4.0.1" date="2026-11-01">
      <description translate="no">
        <ul>
          <li>Updated the GNOME runtime to version 50</li>
          <li>Updated mat2</li>
          <li>Added the R shortcut to clear the list of files</li>
          <li>Clarified the wording of the clear list of files action</li>
          <li>The details view is only cleared when revealed manually</li>
          <li>Updated translations</li>
        </ul>
      </description>
    </release>
    <release version="4.0.0" date="2026-03-28">
      <description translate="no">
        <ul>
          <li>Visual refinements to match the state of the art of GNOME apps</li>
          <li>Added a beautiful drop overlay shown when drag and dropping files</li>
          <li>Simplified some widgets</li>
          <li>Added toasts</li>
          <li>Redesigned with better support for mobile devices</li>
          <li>Better support for sandboxed environments: portals, real file paths</li>
          <li>Fixed file-state related bugs</li>
          <li>Replaced help pages with an in-app dialog</li>
          <li>Other minor bug fixes and codebase improvements</li>
        </ul>
      </description>
    </release>
