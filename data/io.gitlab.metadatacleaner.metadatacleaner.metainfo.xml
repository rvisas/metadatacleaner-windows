  <name>Metadata Cleaner</name>
  <summary>View and clean metadata in files</summary>
  <metadata_license>CC-BY-SA-4.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name its:translate="no">Metadata Cleaner Developers</developer_name>
  <developer id="io.gitlab.metadatacleaner">
    <name translate="no">Metadata Cleaner Developers</name>
  </developer>

  <url type="homepage">https://gitlab.com/metadatacleaner/metadatacleaner</url>
  <url type="bugtracker">https://gitlab.com/metadatacleaner/metadatacleaner/-/issues</url>
