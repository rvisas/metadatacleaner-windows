#!/usr/bin/env python3

# SPDX-FileCopyrightText: Metadata Cleaner contributors
# SPDX-License-Identifier: GPL-3.0-or-later

"""Entry script for Metadata Cleaner."""

import gettext
import locale
import logging
import mimetypes
import os
import signal
import sys
from pathlib import Path

import gi

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")


APP_ID = "@app_id@"
DEVEL = "@devel@" == "True"
VERSION = "@version@"

# Windows needs an explicit AppUserModelID so taskbar buttons and pinned
# shortcuts resolve to this application instead of the Python host process.
if os.name == "nt":
    import ctypes

    ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(APP_ID)

# Derive the install layout from this script's location so the build can be
# relocated (needed for the Windows portable build, harmless on Linux).
_APP_ROOT = Path(__file__).resolve().parent.parent
LOCALE_DIR = str(_APP_ROOT / "share" / "locale")
PKGDATA_DIR = str(_APP_ROOT / "share" / "metadata-cleaner")

sys.path.insert(1, PKGDATA_DIR)
os.unsetenv("GTK_THEME")

from metadatacleaner.modules.language import (  # noqa: E402
    apply_language,
    detect_language,
)


def setup_i18n() -> None:
    """Set the text domain for translations."""
    language = detect_language()
    apply_language(language)

    try:
        locale.bindtextdomain(APP_ID, LOCALE_DIR)  # type: ignore
        locale.textdomain(APP_ID)  # type: ignore
    except AttributeError:
        # Windows Python has no locale.bindtextdomain. GTK (a C library) reads
        # the domain from libintl, not from Python's gettext module, so set it
        # there as well or every string in the .ui templates stays English.
        _bind_libintl()
    gettext.bindtextdomain(APP_ID, LOCALE_DIR)
    gettext.textdomain(APP_ID)


def _bind_libintl() -> None:
    """Bind the gettext domain for the C side (GTK templates)."""
    if os.name != "nt":
        return
    try:
        import ctypes

        libintl = None
        for name in ("libintl-8.dll", "libintl.dll"):
            try:
                libintl = ctypes.CDLL(name)
                break
            except OSError:
                continue
        if libintl is None:
            return
        libintl.libintl_bindtextdomain.argtypes = [
            ctypes.c_char_p,
            ctypes.c_char_p,
        ]
        libintl.libintl_bindtextdomain.restype = ctypes.c_char_p
        libintl.libintl_textdomain.argtypes = [ctypes.c_char_p]
        libintl.libintl_bindtextdomain(
            APP_ID.encode("utf-8"), LOCALE_DIR.encode("utf-8")
        )
        libintl.libintl_textdomain(APP_ID.encode("utf-8"))
    except (AttributeError, OSError):
        logging.warning("Unable to bind the gettext domain for GTK.")


def setup_resources() -> None:
    """Load the application resources."""
    from gi.repository import Gio

    resource = Gio.Resource.load(
        str(Path(PKGDATA_DIR) / f"{APP_ID}.gresource")
    )
    Gio.Resource._register(resource)


def setup_mimetypes() -> None:
    """Add a mime.types file for the Flatpak runtime."""
    if Path("/.flatpak-info").exists():
        mimetypes.init(files=mimetypes.knownfiles + ["/app/share/mime.types"])


def run_app() -> int:
    """Run the application.

    Returns:
        int: Exit status
    """
    from metadatacleaner.app import MetadataCleaner
    from gi.repository import Gtk

    if os.name == "nt":
        # Give the GTK window the application icon instead of the Python icon.
        Gtk.Window.set_default_icon_name(APP_ID)

    app = MetadataCleaner(application_id=APP_ID, devel=DEVEL, version=VERSION)
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    return app.run(sys.argv)


if __name__ == "__main__":
    setup_i18n()
    setup_resources()
    setup_mimetypes()

    sys.exit(run_app())
