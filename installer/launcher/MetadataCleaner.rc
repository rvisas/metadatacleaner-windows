#include <windows.h>

1 ICON "../branding/metadatacleaner-windows.ico"

#ifndef MC_VERSION
#define MC_VERSION 4,0,1,6
#endif
#ifndef MC_VERSION_STRING
#define MC_VERSION_STRING "4.0.1.6"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MC_VERSION
 PRODUCTVERSION MC_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ronny Visa"
            VALUE "FileDescription", "Metadata Cleaner for Windows launcher"
            VALUE "FileVersion", MC_VERSION_STRING
            VALUE "InternalName", "MetadataCleaner"
            VALUE "OriginalFilename", "MetadataCleaner.exe"
            VALUE "ProductName", "Metadata Cleaner"
            VALUE "ProductVersion", MC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
